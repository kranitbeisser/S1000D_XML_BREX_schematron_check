<Elements>
<Element description='This element wraps all "Add before" and "Add after" generated text.' name="_sfe:BeforeOrAfterText" style="nostyle"><?Pub Dtl?>
<Context priority="0" selector="_sfe:BeforeOrAfterText">
<BaseProperties></BaseProperties>
</Context>
</Element>
<Element description='This element wraps the content of each item whose content is inserted by Insert Element Content, when occurrence is "all".' name="_sfe:CollectionItem" style="inline"><?Pub Dtl?>
<Context priority="14.01" selector="_sfe:CollectionItem[1]">
<BaseProperties>
<Breaks blockOrInline="inline"/></BaseProperties>
</Context>
<Context priority="9.01" selector="_sfe:CollectionItem[position()>1 and not(position()=last())]">
<BaseProperties>
<Breaks blockOrInline="inline"/>
<GeneratedText>
<AddBefore><_sfe:BeforeOrAfterText>, </_sfe:BeforeOrAfterText></AddBefore>
</GeneratedText>
</BaseProperties>
</Context>
<Context priority="4.01" selector="_sfe:CollectionItem[last()]">
<BaseProperties>
<Breaks blockOrInline="inline"/>
<GeneratedText>
<AddBefore><_sfe:BeforeOrAfterText>, and </_sfe:BeforeOrAfterText></AddBefore>
</GeneratedText>
</BaseProperties>
</Context>
<Context priority="0" selector="_sfe:CollectionItem">
<BaseProperties>
<Breaks blockOrInline="inline"/></BaseProperties>
</Context>
</Element>
<Element description="This element wraps all generated cross-references." name="_sfe:CrossReference" style="inline"><?Pub Dtl?>
<Context priority="0" selector="_sfe:CrossReference">
<BaseProperties></BaseProperties>
</Context>
</Element>
<Element description="This element wraps title text in a cross-reference" name="_sfe:CrossReferenceTitle" style="inline"><?Pub Dtl?>
<Context priority="10" selector="_sfe:HeaderOrFooter//_sfe:CrossReferenceTitle">
<BaseProperties></BaseProperties>
</Context>
<Context priority="0" selector="_sfe:CrossReferenceTitle">
<BaseProperties>
<Font italic="yes"/></BaseProperties>
</Context>
</Element>
<Element description="This element wraps headers, footers, TOCs, cross references, and repeating titles generated text." name="_sfe:Gentext" style="nostyle"><?Pub Dtl?>
<Context priority="0" selector="_sfe:Gentext">
<BaseProperties></BaseProperties>
</Context>
</Element>
<Element description="This element wraps all headers and footers." name="_sfe:HeaderOrFooter" style="block"><?Pub Dtl?>
<Context priority="0" selector="_sfe:HeaderOrFooter">
<BaseProperties>
<SpaceBefore maximum="0pt" minimum="0pt" optimum="0pt" precedence="force"/>
<Breaks blockOrInline="block"/></BaseProperties>
</Context>
</Element>
<Element description="This element wraps all indexes." name="_sfe:Index" style="block"><?Pub Dtl?>
<Context priority="0" selector="_sfe:Index">
<BaseProperties>
<Breaks blockOrInline="block"/></BaseProperties>
</Context>
</Element>
<Element description="This element wraps the group head and all index entries for an alphabetic group." name="_sfe:IndexAlphaGroup" style="block"><?Pub Dtl?>
<Context priority="0" selector="_sfe:IndexAlphaGroup">
<BaseProperties>
<SpaceBefore maximum="1.6pc" minimum="1.2pc" optimum="1.5pc" precedence="medium"/>
<Breaks blockOrInline="block"/></BaseProperties>
</Context>
</Element>
<Element description="This element contains the text of the last page number in a merged page number range." name="_sfe:IndexEndPage" style="inline"><?Pub Dtl?>
<Context priority="0" selector="_sfe:IndexEndPage">
<BaseProperties>
<GeneratedText>
<AddBefore><_sfe:BeforeOrAfterText>–</_sfe:BeforeOrAfterText></AddBefore>
</GeneratedText>
</BaseProperties>
</Context>
</Element>
<Element description="This element wraps an index entry at any level." name="_sfe:IndexEntry" style="block"><?Pub Dtl?>
<Context priority="30" selector="_sfe:IndexEntry/_sfe:IndexEntry/_sfe:IndexEntry/_sfe:IndexEntry">
<BaseProperties>
<Indent firstLineIndent="*-.5em" leftIndent="@1em"/>
<Alignment align="left"/>
<Breaks blockOrInline="block"/></BaseProperties>
</Context>
<Context priority="20" selector="_sfe:IndexEntry/_sfe:IndexEntry/_sfe:IndexEntry">
<BaseProperties>
<Indent firstLineIndent="*-.5em" leftIndent="@1em"/>
<Alignment align="left"/>
<Breaks blockOrInline="block"/></BaseProperties>
</Context>
<Context priority="10" selector="_sfe:IndexEntry/_sfe:IndexEntry">
<BaseProperties>
<Indent firstLineIndent="*-.5em" leftIndent="@1em"/>
<Alignment align="left"/>
<Breaks blockOrInline="block"/></BaseProperties>
</Context>
<Context priority="0" selector="_sfe:IndexEntry">
<BaseProperties>
<Indent firstLineIndent="*-.5em" lastLineRightIndent="0pt" leftIndent="@.5em" rightIndent="@2pc"/>
<Alignment align="left"/>
<Breaks blockOrInline="block"/></BaseProperties>
</Context>
</Element>
<Element description="This element contains the heading for a group of index entries." name="_sfe:IndexGroupHead" style="block"><?Pub Dtl?>
<Context priority="0" selector="_sfe:IndexGroupHead">
<BaseProperties>
<Font family="sanserif" size="14pt" weight="bold"/>
<Highlight allcaps="yes"/>
<Alignment align="left"/>
<SpaceAfter minimum=".3pc" optimum=".5pc" precedence="medium"/>
<Breaks blockOrInline="block"/>
<Keep withNext="7"/></BaseProperties>
</Context>
</Element>
<Element description="This element contains the indexed text of an index entry." name="_sfe:IndexHeading" style="inline"><?Pub Dtl?>
<Context priority="0" selector="_sfe:IndexHeading">
<BaseProperties>
<Keep keepScope="withinLine" together="3"/></BaseProperties>
</Context>
</Element>
<Element description="This element wraps the page numbers or other locators of an index entry." name="_sfe:IndexLocators" style="inline"><?Pub Dtl?>
<Context priority="0" selector="_sfe:IndexLocators">
<BaseProperties>
<GeneratedText>
<AddBefore><_sfe:BeforeOrAfterText><_gte:Leaders leaderType="dots" leaderSpacing="1em" lenType="fit" minLen="3.00em"/></_sfe:BeforeOrAfterText></AddBefore>
</GeneratedText>
</BaseProperties>
</Context>
</Element>
<Element description="This element contains the text of a single page number or other locator." name="_sfe:IndexPage" style="inline"><?Pub Dtl?>
<Context priority="2" selector="_sfe:IndexPage[position()>1]">
<BaseProperties>
<GeneratedText>
<AddBefore><_sfe:BeforeOrAfterText>, </_sfe:BeforeOrAfterText></AddBefore>
</GeneratedText>
</BaseProperties>
</Context>
<Context priority="0" selector="_sfe:IndexPage">
<BaseProperties></BaseProperties>
</Context>
</Element>
<Element description="This element wraps a group head and all index entries that follow alphabetic entries." name="_sfe:IndexPostGroup" style="block"><?Pub Dtl?>
<Context priority="0" selector="_sfe:IndexPostGroup">
<BaseProperties>
<SpaceBefore maximum="1.6pc" minimum="1.2pc" optimum="1.5pc" precedence="medium"/>
<Breaks blockOrInline="block"/></BaseProperties>
</Context>
</Element>
<Element description="This element wraps a group head and all index entries that precede alphabetic entries." name="_sfe:IndexPreGroup" style="block"><?Pub Dtl?>
<Context priority="0" selector="_sfe:IndexPreGroup">
<BaseProperties>
<SpaceBefore maximum="1.6pc" minimum="1.2pc" optimum="1.5pc" precedence="medium"/>
<Breaks blockOrInline="block"/></BaseProperties>
</Context>
</Element>
<Element description="This element wraps the group head and all index entries for a group that encompasses a range of characters." name="_sfe:IndexRangeGroup" style="block"><?Pub Dtl?>
<Context priority="0" selector="_sfe:IndexRangeGroup">
<BaseProperties>
<SpaceBefore maximum="1.6pc" minimum="1.2pc" optimum="1.5pc" precedence="medium"/>
<Breaks blockOrInline="block"/></BaseProperties>
</Context>
</Element>
<Element description='This element contains the text of a "See" reference in an index entry.' name="_sfe:IndexSee" style="inline"><?Pub Dtl?>
<Context priority="0" selector="_sfe:IndexSee">
<BaseProperties>
<GeneratedText>
<AddBefore><_sfe:BeforeOrAfterText>, <_gte:Font Posture="italic">See </_gte:Font></_sfe:BeforeOrAfterText></AddBefore>
</GeneratedText>
</BaseProperties>
</Context>
</Element>
<Element description='This element contains the text of a "See Also" reference in an index entry.' name="_sfe:IndexSeeAlso" style="block"><?Pub Dtl?>
<Context priority="0" selector="_sfe:IndexSeeAlso">
<BaseProperties>
<Indent firstLineIndent="*-1.5em" leftIndent="@3em"/>
<Breaks blockOrInline="block"/>
<GeneratedText>
<AddBefore><_sfe:BeforeOrAfterText><_gte:Font Posture="italic">See also </_gte:Font></_sfe:BeforeOrAfterText></AddBefore>
</GeneratedText>
</BaseProperties>
</Context>
</Element>
<Element description="This element contains the heading for a sub-group of index entries (Chinese modes 1 and 3 only)." name="_sfe:IndexSubGroupHead" style="block"><?Pub Dtl?>
<Context priority="0" selector="_sfe:IndexSubGroupHead">
<BaseProperties>
<Font size="14pt" weight="bold"/>
<Highlight allcaps="yes"/>
<Alignment align="left"/>
<SpaceBefore maximum="2pc" minimum="2pc" optimum="2pc" precedence="high"/>
<Breaks blockOrInline="block"/>
<Keep withNext="7"/></BaseProperties>
</Context>
</Element>
<Element description="This element wraps repeating titles (also known as continued titles)." name="_sfe:RepeatingTitle" style="block"><?Pub Dtl?>
<Context priority="0" selector="_sfe:RepeatingTitle">
