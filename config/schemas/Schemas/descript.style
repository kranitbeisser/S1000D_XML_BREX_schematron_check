</PropertySet>
<PropertySet propertySetId="Title_color"><?Pub Dtl?>
<BaseProperties>
<Highlight color="#0000FF"/></BaseProperties>
</PropertySet>
<PropertySet propertySetId="Title_color_for_print"><?Pub Dtl?>
<BaseProperties>
<Highlight color="#0000FF"/></BaseProperties>
</PropertySet>
<PropertySet propertySetId="Title_font"><?Pub Dtl?>
<BaseProperties>
<Font family="Sanserif"/></BaseProperties>
</PropertySet>
<PropertySet propertySetId="Title_keeps"><?Pub Dtl?>
<BaseProperties>
<Hyphenation hyphenate="no"/>
<Keep keepScope="withinColumn" together="7" withNext="7"/></BaseProperties>
</PropertySet>
<PropertySet propertySetId="Title_space"><?Pub Dtl?>
<BaseProperties>
<LineSpacing lineHeight="1.1em"/>
<SpaceBefore maximum="2em" minimum="1em" optimum="1.5em" precedence="medium"/>
<SpaceAfter maximum="1.5em" minimum=".8em" optimum="1em" precedence="high"/></BaseProperties>
</PropertySet>
