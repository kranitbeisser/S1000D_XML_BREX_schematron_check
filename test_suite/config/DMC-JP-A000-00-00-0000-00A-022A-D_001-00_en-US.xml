            <objectValue valueForm="single" valueAllowed="274BB"/>
            <objectValue valueForm="single" valueAllowed="C0418"/>
          </structureObjectRule>
          <structureObjectRule id="BRDP-AH-41323JP">
            <objectPath allowedObjectFlag="0">/dmodule/identAndStatusSection/dmStatus[sourceDmIdent and not(./remarks/simplePara[starts-with(text(), 'Traduction basée sur Issue') or starts-with(text(), 'Translation based on issue') or starts-with(text(), 'Übersetzung basiert auf issue') or starts-with(text(), 'Traducción basada en la issue')])]</objectPath>
            <objectUse>[BRDP-AH-41323JP] For Tiger program, the element &lt;remarks&gt; must be populated in the translated DM with the information that are present in the source DM (when relevant). In addition, the information “Traduction basée sur Issue xxx (LL)” for French translation, “Translation based on issue XXX (LL)” for English language, ”Übersetzung basiert auf issue XXX (LL)“ for German language or “Traducción basada en la issue XXX (LL)” for Spanish Language must be added. The variable part xxx relates to the Issue Number of the Source DM and LL relates to the source language. (4.1.3 Rules for Translation)</objectUse>
          </structureObjectRule>
